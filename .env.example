# ============================================================
# 配置模板：复制本文件为 .env，并填入你的真实值
#
# 复制方式（Windows PowerShell，在项目根目录执行）：
#     Copy-Item .env.example .env
# ============================================================

# DeepSeek API Key（在 https://platform.deepseek.com 申请）
OPENAI_API_KEY=your_deepseek_api_key_here

# DeepSeek 接口地址（OpenAI 兼容协议）
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型：deepseek-chat（通用对话）/ deepseek-reasoner（深度推理）
MODEL_NAME=deepseek-chat

# Token 单价（元/百万 token），用于估算费用，请以 DeepSeek 官方最新价为准
INPUT_PRICE_PER_MILLION=1.0
OUTPUT_PRICE_PER_MILLION=2.0

# Agent 最大循环次数（防止死循环）
MAX_ITERATIONS=10

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ===== 步骤 5：搜索与抓取 =====
# Tavily 搜索 API Key（在 https://tavily.com 免费注册，1000 次/月）
# 不填也能跑，但会退化成"LLM 模拟搜索"（结果不可信，仅用于体验流程）
TAVILY_API_KEY=your_tavily_api_key_here

# 每次搜索最多取几条结果
SEARCH_MAX_RESULTS=5

# 每次搜索后抓取前 N 条网页正文（设 0 则不抓取，只用搜索摘要）
FETCH_TOP_N=2
